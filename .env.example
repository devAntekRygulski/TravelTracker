MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/travel-tracker
JWT_SECRET=replace-with-a-long-random-secret
PORT=3001
CLIENT_URL=http://localhost:5173
# Dev tip: the frontend calls http://localhost:3001/api directly in development
# so large phone photo downloads are not broken by the Vite proxy.
# VITE_API_URL=http://localhost:3001/api
# Public URL written into phone QR codes (guest + logged-in).
# After deploy: CLIENT_PUBLIC_URL=https://yourapp.com
# On Vercel, VERCEL_URL is used automatically if CLIENT_PUBLIC_URL is unset.
# Local LAN only: CLIENT_LAN_URL=http://192.168.1.20:5173
# Or run `npm run tunnel` while `npm run dev` is up (no .env change needed).
# CLIENT_PUBLIC_URL=
# CLIENT_LAN_URL=

# Required in Vercel Project Settings → Environment Variables (Production):
# MONGODB_URI, JWT_SECRET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_REGION, S3_BUCKET
# Optional: S3_PUBLIC_BASE_URL, CLIENT_PUBLIC_URL

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=your-photo-bucket
# Optional: CloudFront or public bucket base URL for serving photos
S3_PUBLIC_BASE_URL=

# Google Drive + Google Photos import (client-side pickers)
# Enable Google Picker API, Drive API, and Photos Picker API in Cloud Console.
# Create an OAuth Web client + API key; add http://localhost:5173 as an origin.
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-google-api-key
