MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/travel-tracker
JWT_SECRET=replace-with-a-long-random-secret
PORT=3001
CLIENT_URL=http://localhost:5173
# Dev tip: the frontend calls http://localhost:3001/api directly in development
# so large phone photo downloads are not broken by the Vite proxy.
# VITE_API_URL=http://localhost:3001/api
# Public URL written into phone QR codes (guest + logged-in).
# After deploy: CLIENT_PUBLIC_URL=https://yourapp.com
# Local LAN only: CLIENT_LAN_URL=http://192.168.1.20:5173
# Or run `npm run tunnel` while `npm run dev` is up (no .env change needed).
# CLIENT_PUBLIC_URL=
# CLIENT_LAN_URL=

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=your-photo-bucket
# Optional: CloudFront or public bucket base URL for serving photos
S3_PUBLIC_BASE_URL=
